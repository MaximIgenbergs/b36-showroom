---

---

<form id="bewerbung-form" class="max-w-2xl mx-auto space-y-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label
        for="vorname"
        class="block font-sans text-sm font-bold text-villa-dark mb-1"
        >Vorname *</label
      >
      <input
        type="text"
        id="vorname"
        name="vorname"
        required
        class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors"
      />
    </div>
    <div>
      <label
        for="nachname"
        class="block font-sans text-sm font-bold text-villa-dark mb-1"
        >Nachname *</label
      >
      <input
        type="text"
        id="nachname"
        name="nachname"
        required
        class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors"
      />
    </div>
  </div>

  <div>
    <label
      for="email"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
      >E-Mail-Adresse *</label
    >
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors"
    />
  </div>

  <div>
    <label
      for="telefon"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
      >Telefonnummer</label
    >
    <input
      type="tel"
      id="telefon"
      name="telefon"
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors"
    />
  </div>

  <div>
    <label
      for="einzug"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
      >Gewünschter Einzugstermin *</label
    >
    <input
      type="date"
      id="einzug"
      name="einzug"
      required
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors"
    />
  </div>

  <div>
    <label
      for="hochschule"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
      >Dienstverhältnis *</label
    >
    <input
      type="text"
      id="hochschule"
      name="hochschule"
      required
      placeholder="z.B. Ausbilder"
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors"
    />
  </div>

  <div>
    <label
      for="praeferenz"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
      >Apartment-Präferenz</label
    >
    <select
      id="praeferenz"
      name="praeferenz"
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors bg-white"
    >
      <option value="">Keine Präferenz</option>
      <option value="ug">Untergeschoss</option>
      <option value="eg">Erdgeschoss (mit Terrasse)</option>
      <option value="og">Obergeschoss (mit Balkon)</option>
      <option value="dg">Dachgeschoss (mit Balkon)</option>
      <option value="doppel">Doppelapartment D3 (ca. 34 m²)</option>
    </select>
  </div>

  <div>
    <label
      for="immatrikulation"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
    >
      Berechtigungsschein (PDF/JPG) *
    </label>
    <input
      type="file"
      id="immatrikulation"
      name="immatrikulation"
      required
      accept=".pdf,.jpg,.jpeg,.png"
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors file:mr-4 file:py-1 file:px-3 file:border-0 file:text-sm file:font-bold file:bg-villa-gold file:text-white"
    />
    <p class="font-sans text-xs text-villa-charcoal/60 mt-1">
      Maximale Dateigröße: 4 MB
    </p>
  </div>

  <div>
    <label
      for="nachricht"
      class="block font-sans text-sm font-bold text-villa-dark mb-1"
      >Kurzes Anschreiben</label
    >
    <textarea
      id="nachricht"
      name="nachricht"
      rows="4"
      placeholder="Optional: Erzählen Sie uns kurz etwas über sich."
      class="w-full px-4 py-3 border border-villa-charcoal/20 font-sans text-sm focus:outline-none focus:border-villa-gold transition-colors resize-y"
    ></textarea>
  </div>

  <div class="space-y-3">
    <label class="flex items-start gap-3">
      <input
        type="checkbox"
        name="datenschutz"
        required
        class="mt-1 accent-villa-gold"
      />
      <span class="font-sans text-xs text-villa-charcoal">
        Ich habe die <a href="/datenschutz" class="text-villa-gold underline"
          >Datenschutzerklärung</a
        > gelesen und bin mit der Verarbeitung meiner Daten einverstanden. *
      </span>
    </label>
    <label class="flex items-start gap-3">
      <input
        type="checkbox"
        name="makler-hinweis"
        required
        class="mt-1 accent-villa-gold"
      />
      <span class="font-sans text-xs text-villa-charcoal">
        Mir ist bekannt, dass die Vermietung über einen beauftragten Makler
        erfolgt und im Vermietungsfall die gesetzliche Maklerprovision durch
        mich zu tragen ist. *
      </span>
    </label>
  </div>

  <input
    type="text"
    name="_gotcha"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <div id="form-status" class="hidden font-sans text-sm text-center p-4"></div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full bg-villa-gold text-white font-sans font-bold text-base py-4 hover:bg-villa-dark transition-all duration-300"
  >
    Bewerbung absenden
  </button>
</form>

<script>
  const MAX_FILE_SIZE = 4 * 1024 * 1024;

  const form = document.getElementById("bewerbung-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status") as HTMLElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  const showStatus = (message: string, type: "success" | "error") => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden", "bg-red-50", "text-red-700", "bg-green-50", "text-green-700");
    if (type === "success") {
      status.classList.add("bg-green-50", "text-green-700");
    } else {
      status.classList.add("bg-red-50", "text-red-700");
    }
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !form) return;

    const fileInput = document.getElementById("immatrikulation") as HTMLInputElement | null;
    const file = fileInput?.files?.[0];
    if (file && file.size > MAX_FILE_SIZE) {
      showStatus("Datei ist größer als 4 MB. Bitte wählen Sie eine kleinere Datei.", "error");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Wird gesendet...";
    submitBtn.classList.add("opacity-50");

    try {
      const formData = new FormData(form);
      const response = await fetch("/api/bewerbung", {
        method: "POST",
        body: formData,
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result.error || "Ein Fehler ist aufgetreten.");
      }

      showStatus(
        "Ihre Bewerbung wurde erfolgreich gesendet! Wir melden uns in Kürze bei Ihnen.",
        "success",
      );
      form.reset();
    } catch (err) {
      const message =
        err instanceof Error
          ? err.message
          : "Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.";
      showStatus(message, "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Bewerbung absenden";
      submitBtn.classList.remove("opacity-50");
    }
  });
</script>
